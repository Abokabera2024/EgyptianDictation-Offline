<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EgyptianDictationSetup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EgyptianDictation.Contracts\EgyptianDictation.Contracts.csproj" />
    <EmbeddedResource Include="..\..\installer\payload.zip" LogicalName="EgyptianDictation.payload.zip"
                      Condition="Exists('..\..\installer\payload.zip')" />
    <EmbeddedResource Include="..\..\prerequisites\manifest.json" LogicalName="EgyptianDictation.prerequisites.json" />
    <EmbeddedResource Include="..\..\docs\TERMS_AR.txt" LogicalName="EgyptianDictation.terms-ar.txt" />
  </ItemGroup>
</Project>
